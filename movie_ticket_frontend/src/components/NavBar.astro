---
import { Astro } from "astro";
const { user } = Astro.props;
// PUBLIC_INTERFACE
/**
 * NavBar component. Receives `user` (null or user object). Shows login/logout and navigation.
 */
---
<nav class="navbar">
  <div class="nav-brand">
    <a href="/" class="brand">🎬 MovieBooker</a>
  </div>
  <div class="nav-links">
    <a href="/movies" class="nav-link">Movies</a>
    {user ? <a href="/my-tickets" class="nav-link">My Tickets</a> : null}
  </div>
  <div class="nav-account">
    {user ? (
      <>
        <span class="user-greet">Hi, {user.email}</span>
        <form action="/logout" method="post" style="display:inline;">
          <button class="btn btn-secondary" type="submit">Logout</button>
        </form>
      </>
    ) : (
      <a class="btn btn-accent" href="/login">Login / Sign Up</a>
    )}
  </div>
</nav>

<style>
@import "../styles/theme.css";
.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  background: #fff;
  border-bottom: 1px solid var(--color-border);
  height: var(--nav-height);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 2.2em;
}
.nav-brand .brand {
  font-size: 1.4rem;
  font-weight: 700;
  color: var(--color-primary);
}
.nav-links {
  display: flex;
  gap: 1.1em;
  font-size: 1.07em;
}
.nav-link {
  color: var(--color-secondary);
  transition: color .14s;
}
.nav-link:hover {
  color: var(--color-primary);
}
.nav-account {
  display: flex;
  align-items: center;
  gap: 0.8em;
}
.user-greet {
  color: var(--color-secondary);
  font-size: 0.92em;
  margin-right: 0.4em;
}
@media (max-width: 600px) {
  .navbar {
    padding: 0 1em;
  }
  .nav-links { gap: .7em; }
}
</style>
