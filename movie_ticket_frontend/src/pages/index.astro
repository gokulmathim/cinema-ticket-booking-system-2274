---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import { getUser } from '../utils/api.ts';

let user = getUser();

if (user) {
  // If user is logged in, redirect to /movies
  if (typeof window !== 'undefined') window.location.href = "/movies";
}
---

<Layout>
  <NavBar user={user} />
  <main style="min-height:70vh;display:flex;align-items:center;justify-content:center;">
    <section class="card" style="text-align:center;">
      <h1>Welcome to MovieBooker 🎬</h1>
      <p>Browse movies &amp; book your perfect seat!</p>
      <a href="/movies" class="btn btn-primary" style="margin-top:1.2em;">Browse Movies</a>
    </section>
  </main>
</Layout>
