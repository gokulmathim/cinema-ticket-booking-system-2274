---
import Layout from '../layouts/Layout.astro';
import NavBar from '../components/NavBar.astro';
import { apiFetch, getUser } from '../utils/api.ts';

let movies = [];
let user = getUser();

Astro.fetchContent().then(async () => {
  movies = await apiFetch('/movies');
});
---
<Layout>
  <NavBar user={user}/>
  <main style="padding: 2em;">
    <h1>Now Showing</h1>
    <div class="grid grid-cols-3">
      {movies.map(movie => (
        <div class="card movie-card">
          <img src={movie.poster_url || "/placeholder-movie.jpg"} alt={movie.title} class="movie-poster"/>
          <div class="movie-info">
            <h2 class="movie-title">{movie.title}</h2>
            <p>{movie.description}</p>
            <a class="btn btn-accent" href={"/movies/" + movie.id}>View Showtimes</a>
          </div>
        </div>
      ))}
    </div>
  </main>
</Layout>
<style>
@import "../styles/theme.css";
.movie-card {
  display: flex;
  flex-direction: column;
  height: 100%;
}
.movie-poster {
  width: 100%;
  height: 310px;
  object-fit: cover;
  border-radius: 12px 12px 0 0;
}
.movie-title {
  margin: 0.37em 0 0.19em 0;
  color: var(--color-primary);
}
.movie-info { flex: 1 1 auto; }
@media (max-width: 900px) {
  .grid { grid-template-columns: 1fr 1fr; }
}
@media (max-width: 600px) {
  .grid { grid-template-columns: 1fr; }
}
</style>
